{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/spots", "dest": "/public/spots-map.html" },
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/(rakni-app-icon.png|manifest.webmanifest|spots-map.html)", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
